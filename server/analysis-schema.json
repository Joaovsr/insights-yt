{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "generatedAt": { "type": "string" },
    "overview": { "type": "string", "maxLength": 420 },
    "videos": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "properties": {
          "videoId": { "type": "string" },
          "url": { "type": "string" },
          "title": { "type": "string", "maxLength": 160 },
          "channel": { "type": "string", "maxLength": 100 },
          "thumbnail": { "type": "string" },
          "commentCountAnalyzed": { "type": "integer" },
          "summary": { "type": "string", "maxLength": 360 },
          "sentiment": {
            "type": "object",
            "properties": {
              "positive": { "type": "number" },
              "neutral": { "type": "number" },
              "negative": { "type": "number" }
            },
            "required": ["positive", "neutral", "negative"],
            "additionalProperties": false
          },
          "tags": {
            "type": "array",
            "minItems": 4,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string", "maxLength": 36 },
                "description": { "type": "string", "maxLength": 180 },
                "commentCount": { "type": "integer" },
                "sentiment": { "type": "string", "enum": ["positive", "neutral", "negative"] },
                "keywords": { "type": "array", "maxItems": 6, "items": { "type": "string", "maxLength": 30 } },
                "examples": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "author": { "type": "string" },
                      "text": { "type": "string", "maxLength": 280 },
                      "likes": { "type": "integer" }
                    },
                    "required": ["id", "author", "text", "likes"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["id", "label", "description", "commentCount", "sentiment", "keywords", "examples"],
              "additionalProperties": false
            }
          }
        },
        "required": ["videoId", "url", "title", "channel", "thumbnail", "commentCountAnalyzed", "summary", "sentiment", "tags"],
        "additionalProperties": false
      }
    },
    "sharedThemes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "label": { "type": "string", "maxLength": 36 },
          "description": { "type": "string", "maxLength": 180 },
          "videoIds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
        },
        "required": ["label", "description", "videoIds"],
        "additionalProperties": false
      }
    },
    "takeaways": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "maxLength": 220 } }
  },
  "required": ["generatedAt", "overview", "videos", "sharedThemes", "takeaways"],
  "additionalProperties": false
}
